# multispack RUNTIME image: alma9-run  (see Containerfile.debian13-run).  Bare
# almalinux:9 + the minimal packages to run Spack tooling (multispack.sh runenv):
# python3.11 (the distro python3 is 3.6 -- too old for Spack; the builder uses 3.11
# the same way) and git.  The bare `alma9` validator stays empty; not here.
FROM docker.io/library/almalinux:9
LABEL org.opencontainers.image.title="multispack runtime alma9" \
      org.opencontainers.image.description="AlmaLinux 9 + python3.11 + git: run Spack tooling against the /cvmfs store"
RUN dnf -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs install python3.11 git \
    && dnf clean all && rm -rf /var/cache/dnf \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3
COPY tests /opt/multispack/tests
CMD ["/bin/bash", "-l"]
