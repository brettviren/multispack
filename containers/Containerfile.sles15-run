# multispack RUNTIME image: sles15-run  (see Containerfile.debian13-run).  Bare
# SLES BCI + the minimal packages to run Spack tooling (multispack.sh runenv):
# python311 (distro python3 is too old for Spack; matches the builder's 3.11) and
# git.  The bare `sles15` validator stays empty; do not add these there.
FROM registry.suse.com/bci/bci-base:15.6
LABEL org.opencontainers.image.title="multispack runtime sles15" \
      org.opencontainers.image.description="SLES 15 + python3.11 + git: run Spack tooling against the /cvmfs store"
RUN zypper -n install python311 git \
    && zypper clean -a \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3
COPY tests /opt/multispack/tests
CMD ["/bin/bash", "-l"]
