# multispack DEVEL validator: sles15-devel
# SLES 15 SP6 (proxy for DOE HPC facility login/compute nodes) + the MINIMAL
# packages the shipped gcc@15 needs to compile AND link a C/C++ program.
#
# The bare validators prove the shipped compiler *runs*.  These -devel validators
# prove the distribution can *host a build* against it, and document -- one
# package at a time -- exactly what a downstream application stack must add to a
# bare install.  Keep the delta minimal and commented: this file IS the manifest
# of "what sles15 needs to build C++".  This is the row that speaks directly to
# what a DOE HPC facility node must provide for site builds.
#
# What is added, and why:
#   glibc-devel  The C library headers (/usr/include, <features.h> and friends),
#                the C runtime startup objects (crt1.o, crti.o, crtn.o) and the
#                libc.so linker script.  Pulls in linux-glibc-devel (kernel
#                headers).  This is the ENTIRE delta from bare: the compiler
#                driver, the assembler and linker (gcc is built +binutils), the
#                C++ standard headers and libstdc++/libgcc_s all ship from
#                /cvmfs, not from the distro.
#
# Extension pattern for future stacks: a stack-specific validator (e.g. CUDA
# Toolkit) should start `FROM localhost/multispack/sles15-devel:<IMG_TAG>` and add
# ONLY the further packages that stack requires, so each Containerfile stays a
# precise, reviewable statement of that stack's minimal host requirements.
FROM registry.suse.com/bci/bci-base:15.6

LABEL org.opencontainers.image.title="multispack devel validator sles15" \
      org.opencontainers.image.description="SLES 15 SP6 + glibc-devel: minimal C++ build host for the shipped gcc@15"

RUN zypper -n install glibc-devel && zypper clean -a

COPY tests /opt/multispack/tests

CMD ["/bin/sh", "/opt/multispack/tests/run-compiler-validation.sh"]
