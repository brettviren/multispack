# Copy to multispack.conf and edit.  Every value here is a default from
# multispack.sh; uncomment only what you change.

# --- the deployment path (baked into every install prefix) -------------------
#CVMFS_HOST=multispack.example.org
#CVMFS_ROOT=/cvmfs/${CVMFS_HOST}

# --- the portability contract ------------------------------------------------
# The base image's glibc IS the floor of the resulting binaries.
# AlmaLinux 8 = glibc 2.28 = the manylinux_2_28 baseline.
# PIN BY DIGEST once the first run succeeds:
#   BUILDER_BASE=docker.io/library/almalinux@sha256:....
#BUILDER_BASE=docker.io/library/almalinux:8
#TARGET=x86_64_v3

# --- Spack -------------------------------------------------------------------
#SPACK_REF=v1.2.2
#SPACK_PACKAGES_REF=v1.2.2

# --- toolchain ---------------------------------------------------------------
# The bootstrap ladder: base image gcc 8.5 -> GCC_SPEC -> GCC_TARGET_SPEC.
# GCC_SPEC builds the stack; GCC_TARGET_SPEC is the portability payload that
# `multispack.sh compiler-validate` runs in every VALIDATORS distribution.
# +binutils makes the target compiler ship its own as/ld so it is self-contained
# in a bare container (drop it and compile-run degrades to a SKIP there).
#GCC_SPEC=gcc@14
#GCC_LANGS=c,c++,fortran
#GCC_TARGET_SPEC=gcc@15
#GCC_TARGET_VARIANTS='+binutils'

# --- payload -----------------------------------------------------------------
#ROOT_PKG=root
# Adjust after the first `./multispack.sh concretize`; run `spack info root`
# in `./multispack.sh shell` to see the real variant names for your Spack.
#ROOT_VARIANTS='~x ~opengl ~examples ~tmva'
#CXXSTD_LIST='17 23'
#BASE_CXXSTD=17

# --- relocation --------------------------------------------------------------
# 0 disables padding: shorter paths and easier debugging, but the tree can then
# only be relocated to an equal-or-longer path.
#PADDED_LENGTH=128
# 1 converts DT_RPATH to DT_RUNPATH so LD_LIBRARY_PATH can inject host libcuda.
# Leave 0 for ROOT: RUNPATH is not inherited by dlopen and ROOT dlopens heavily.
#ORIGINIZE_RUNPATH=0

# --- resources ---------------------------------------------------------------
# ROOT builds LLVM.  Budget ~2 GiB of RAM per job or the linker will OOM.
#BUILD_JOBS=0        # 0 => nproc

# --- podman ------------------------------------------------------------------
#ENGINE=podman
#VALIDATORS='alma8 alma9 debian12 debian13 sles15 alpine'
# Non-bare validators: bare distro + the minimal packages the shipped compiler
# needs to BUILD C++ (see containers/Containerfile.*-devel).  `compiler-validate`
# runs these too, so its compile-run row passes (bare validators skip it).
#DEVEL_VALIDATORS='alma8-devel alma9-devel debian12-devel debian13-devel sles15-devel'
# Runtime images (bare distro + python3 + git) for `runenv` on a minimal distro.
# Not built by default; `multispack.sh images debian13-run` builds one on demand.
#RUN_VALIDATORS='alma8-run alma9-run debian12-run debian13-run sles15-run'
# Default build container for `makenv`.  Must run Spack AND supply OS-level build
# deps; the builder is manylinux base + Spack prereqs + glibc-dev.  A CUDA build
# image should be built FROM the builder and passed as `makenv --image`.
#MAKENV_IMAGE=builder
#DEV_MOUNTS=1        # 0 for a sealed run that uses only what is baked in images
#SEL=               # ':z' if SELinux denies the volume mounts
